        "partitions": [
          {
            "name": "Sales",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [fact].[Sales].*   FROM [fact].[Sales] ",
              "dataSource": "SqlServer localhost LusitaniaDW"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": " SUM ( Sales[NetAmount] )",
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"2070\" DisplayName=\"€ Portuguese (Portugal)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          },
          {
            "name": "Gross Sales",
            "expression": " SUM ( Sales[GrossAmount] )",
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"2070\" DisplayName=\"€ Portuguese (Portugal)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Discount",
            "expression": " SUM ( Sales[DiscountAmount] )",
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1027\" DisplayName=\"€ Euro(123 €)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          },
          {
            "name": "Units Sold",
            "expression": " SUM ( Sales[Quantity] )",
            "formatString": "0"
          },
          {
            "name": "Orders",
            "expression": " DISTINCTCOUNT ( Sales[OrderNumber] )",
            "formatString": "0"
          },
          {
            "name": "Avg Order Value",
            "expression": " DIVIDE ( [Total Sales], [Orders] )",
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"2070\" DisplayName=\"€ Portuguese (Portugal)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          },
          {
            "name": "Discount %",
            "expression": " DIVIDE ( [Total Discount], [Gross Sales] )",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Sales LY",
            "expression": [
              "",
              "VAR LastSalesKey =",
              "    CALCULATE ( MAX ( Sales[DateKey] ), ALL ( Sales ) )",
              "VAR DatesWithData =",
              "    CALCULATETABLE ( VALUES ( 'Date'[FullDate] ), 'Date'[DateKey] <= LastSalesKey )",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( [Total Sales] ),",
              "        CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( DatesWithData ) )",
              "    )"
            ],
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"2070\" DisplayName=\"€ Portuguese (Portugal)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          },
          {
            "name": "Sales YoY %",
            "expression": [
              "",
              "IF (",
              "    NOT ISBLANK ( [Sales LY] ),",
              "    DIVIDE ( [Total Sales] - [Sales LY], [Sales LY] )",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Sales YTD",
            "expression": " TOTALYTD ( [Total Sales], 'Date'[FullDate] )"
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": " \t\t\t\tSELECT [fact].[Sales].*   FROM [fact].[Sales] "
          },
